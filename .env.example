# Browser-safe variables
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_SENTRY_DSN=
VITE_APP_BUILD=
# Canonical HTTPS website origin, e.g. https://your-forgepass-domain.example
# Required in native packages for sharing and browser-based password recovery.
VITE_PUBLIC_SITE_URL=
# HTTPS origin serving /api/*; required for native API requests.
VITE_API_ORIGIN=

# Server-only variables. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
TICKETMASTER_API_KEY=
# Exact comma-separated origins allowed to read API responses. No wildcard.
# Native defaults may be https://localhost and capacitor://localhost; verify on devices.
API_ALLOWED_ORIGINS=

# Optional city and navigation providers
VITE_MAP_PROVIDER=google
VITE_MAPBOX_ACCESS_TOKEN=
CITY_WEATHER_API_URL=
CITY_TRANSIT_API_URL=
CITY_TRAFFIC_API_URL=
